# WHMCS API Credentials
# Get these from WHMCS > Setup > Staff Management > API Tokens
VITE_WHMCS_API_URL=https://your-whmcs-domain.com/includes/api.php
VITE_WHMCS_API_IDENTIFIER=your_api_identifier
VITE_WHMCS_API_SECRET=your_api_secret

# Provisioning Secret (Used for WHMCS Hook to call our backend)
VITE_WHMCS_PROVISION_SECRET=WHMCS_FIREVPS_SECRET_2026

# Virtualizor API Configuration
VITE_VIRTUALIZOR_URL=https://your-virtualizor-panel:4085
VITE_VIRTUALIZOR_KEY=your_api_key
VITE_VIRTUALIZOR_PASS=your_api_password

# SMTP Email Configuration
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=465
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASS=your-app-password
VITE_EMAIL_FROM="Jannat IT Support" <your-email@gmail.com>
