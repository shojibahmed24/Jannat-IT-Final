rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- UTILS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        request.auth.token.email == 'shojib4chatgpt@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'avatar', 'twoFactorEnabled', 'whmcsClientId'])) || isAdmin();
    }

    // --- SERVICES ---
    match /services/{serviceId} {
      allow read: if (isSignedIn() && (resource == null || existing().userId == request.auth.uid)) || isAdmin();
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- TICKETS ---
    match /tickets/{ticketId} {
      allow read: if (isSignedIn() && (resource == null || existing().userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdate'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- ACTIVITIES ---
    match /activities/{activityId} {
      allow read: if (isSignedIn() && (resource == null || existing().userId == request.auth.uid)) || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if (isSignedIn() && (resource == null || existing().userId == request.auth.uid)) || isAdmin();
      allow create: if isAdmin();
      allow update: if (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- SETTINGS ---
    match /settings/{settingsId} {
      allow read: if true; // Publicly readable for pricing
      allow write: if isAdmin();
    }

    // --- CATCH ALL ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
